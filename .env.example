# CareerAI - Environment Configuration Template
# Copy this file to .env and customize as needed.

# ==============================================================================
# AI Provider Configuration (Optional)
# If left empty, CareerAI automatically operates in deterministic Local / Rule-Based mode.
# ==============================================================================
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# ==============================================================================
# Application Settings
# ==============================================================================
APP_NAME=CareerAI
APP_ENV=development
APP_PORT=8501
DEBUG=false

# Maximum resume upload file size in Megabytes (MB)
MAX_UPLOAD_SIZE_MB=5

# Database configuration
DB_PATH=database/careerai.db

# ==============================================================================
# Privacy & Data Retention Settings
# When PERSIST_UPLOADS is false, uploaded resumes are held in-memory/temp only
# and wiped immediately after analysis. No PII is logged or stored without consent.
# ==============================================================================
PERSIST_UPLOADS=false
ANONYMIZE_LOGS=true
